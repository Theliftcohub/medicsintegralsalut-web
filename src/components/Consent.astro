---
// Banner de cookies propio y mínimo (al final del <body>): Aceptar y Rechazar al mismo nivel (guía AEPD). Textos en ui.json.
// Los valores por defecto (todo denegado) los fija ConsentMode.astro en <head>.
import ui from '../i18n/ui.json';
const { lang = 'es' } = Astro.props;
const t = (ui as any)[lang] ?? ui.es;
---
<div id="cmp" class="cmp" hidden>
  <p>{t.cookies_text} <a href={t.cookies_href}>{t.cookies_link}</a></p>
  <div class="cmp-btns">
    <button type="button" data-consent="denied">{t.cookies_reject}</button>
    <button type="button" data-consent="granted">{t.cookies_accept}</button>
  </div>
</div>
<script is:inline>
  (function(){var el=document.getElementById('cmp');var v=null;try{v=localStorage.getItem('mis-consent')}catch(e){}
  if(!v&&el)el.hidden=false;
  el&&el.addEventListener('click',function(e){var b=e.target.closest('[data-consent]');if(!b)return;var c=b.getAttribute('data-consent');
  try{localStorage.setItem('mis-consent',c)}catch(e){}
  if(c==='granted')gtag('consent','update',{ad_storage:'granted',analytics_storage:'granted',ad_user_data:'granted',ad_personalization:'granted'});
  el.hidden=true;});})();
</script>
