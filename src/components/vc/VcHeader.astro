---
// Cabecera «Versión C». Etiquetas y enlaces por idioma en src/data/vc-chrome.json (literales del menú del WordPress).
import chrome from '../../data/vc-chrome.json';
import site from '../../data/site.json';
import ui from '../../i18n/ui.json';
const { lang = 'es', alternates = {} } = Astro.props;
const C: any = (chrome as any)[lang] ?? (chrome as any).es;
const isHome = Astro.url.pathname === C.home;
// las anclas de la portada (#info, #unidades) fuera de ella apuntan a sus páginas
const fx = (h: string) => (isHome || !h?.startsWith('#') ? h : C.anchors[h] ?? C.home + h);
const t = (ui as any)[lang] ?? ui.es;
const names: Record<string, string> = { es: 'ES', ca: 'CA', en: 'EN', fr: 'FR', ru: 'RU', uk: 'UK' };
const langs = Object.entries(alternates);
const wa = { text: 'WhatsApp 620 892 236', href: 'https://api.whatsapp.com/send?phone=34620892236' };
---
<header id="hdr">
  <div class="wrap-wide bar">
    <a href={C.home}><img class="logo" src={site.logo} alt="clinica estetica girona" width="200" height="79" /></a>
    <nav aria-label={t.menu}>{C.menu.map((i: any) => <a href={fx(i.href)}>{i.text}</a>)}</nav>
    {langs.length > 1 && <ul class="vc-langs">{langs.map(([l, p]) => <li><a href={p as string} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{names[l] ?? l}</a></li>)}</ul>}
    <a class="btn" href={fx(C.cta.href)}><span>{C.cta.text}</span></a>
    <button class="burger" id="burger" aria-label={t.menu_open} aria-controls="panel" aria-expanded="false"><i></i><i></i><i></i></button>
  </div>
</header>
<div class="velo" id="velo"></div>
<nav class="panel" id="panel" aria-label={t.menu}>
  {C.menu.map((i: any) => <a href={fx(i.href)}>{i.text}</a>)}
  <a class="btn" href={fx(C.cta.href)}><span>{C.cta.text}</span></a>
  <a class="btn linea" href={wa.href}><span>{wa.text}</span></a>
  {langs.length > 1 && <ul class="vc-langs vc-langs--panel">{langs.map(([l, p]) => <li><a href={p as string} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{names[l] ?? l}</a></li>)}</ul>}
</nav>
<script is:inline>
(function(){
  var hdr=document.getElementById('hdr');
  var onScroll=function(){ if(window.scrollY>120){hdr.classList.add('stuck');}else{hdr.classList.remove('stuck');} };
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  var burger=document.getElementById('burger'),velo=document.getElementById('velo'),panel=document.getElementById('panel');
  var cerrar=function(){document.body.classList.remove('menu-open');burger.setAttribute('aria-expanded','false');};
  burger.addEventListener('click',function(){var a=document.body.classList.toggle('menu-open');burger.setAttribute('aria-expanded',a?'true':'false');});
  velo.addEventListener('click',cerrar);
  panel.addEventListener('click',function(e){ if(e.target.closest('a')){cerrar();} });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'){cerrar();} });
  window.addEventListener('resize',function(){ if(window.innerWidth>1080){cerrar();} });
  document.addEventListener('DOMContentLoaded',function(){
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -60px 0px'});
      document.querySelectorAll('.rv:not(.on)').forEach(function(el){io.observe(el);});
    } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('on');}); }
  });
})();
</script>
