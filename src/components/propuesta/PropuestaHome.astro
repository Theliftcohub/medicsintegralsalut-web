        <li><a href="https://www.instagram.com/medicsintegralsalut/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.youtube.com/channel/UChnKZOQRgevEvqw-NTaDHpw/videos" target="_blank" rel="noopener">YouTube</a></li>
      </ul>
