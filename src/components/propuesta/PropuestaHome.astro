---
// PROPUESTA de portada (07/10/2026) con el estilo de la landing /clinica/ (petición del cliente)
// + la sección de reels de Instagram que le gustó de la propuesta anterior.
// Componente único para los 6 idiomas (prop `lang`): textos propios en src/data/propuesta-i18n.json;
// los bloques que ya existen en la home.json de cada idioma (pt-clinica, pt-unidades, ps-doctora,
// ps-historias, pt-contacto) se leen de ahí. Datos de negocio de site.json. Siempre noindex.
import '../../styles/propuesta-home.css';
import NativeForm from '../NativeForm.astro';
import site from '../../data/site.json';
import chrome from '../../data/vc-chrome.json';
import ui from '../../i18n/ui.json';
import Bandera from '../vc/Bandera.astro';
import ConsentMode from '../ConsentMode.astro';
import Consent from '../Consent.astro';
import dict from '../../data/propuesta-i18n.json';
import homeEs from '../../content/pages/es/home.json';
import homeCa from '../../content/pages/ca/home.json';
import homeEn from '../../content/pages/en/home.json';
import homeFr from '../../content/pages/fr/home.json';
import homeRu from '../../content/pages/ru/home.json';
import homeUk from '../../content/pages/uk/home.json';

const { lang = 'es' } = Astro.props as { lang?: 'es' | 'ca' | 'en' | 'fr' | 'ru' | 'uk' };
const homes: Record<string, any> = { es: homeEs, ca: homeCa, en: homeEn, fr: homeFr, ru: homeRu, uk: homeUk };
const home = homes[lang];
const d = (dict as any)[lang];
const U = d.urls;

const B = (t: string) => home.blocks.find((b: any) => b.type === t) as any;
const clinica = B('pt-clinica');
const unidades = B('pt-unidades');
const doctora = B('ps-doctora');
const historias = B('ps-historias');
const contacto = B('pt-contacto');
const r = site.rating;
const nota = String(r.value).replace('.', lang === 'en' ? '.' : ',');
const anios = new Date().getFullYear() - r.since;
const IMG = '/propuesta';
const WA = 'https://api.whatsapp.com/send?phone=34620892236';
const TEL = 'tel:+34972209086';
const fmt = (s: string, v: Record<string, string | number> = {}) =>
  Object.entries({ since: r.since, nota, count: r.count, anios, ...v }).reduce((a, [k, x]) => a.split(`{${k}}`).join(String(x)), s);

// Menú y pie del sitio: se leen de vc-chrome.json (la misma fuente que VcHeader/VcFooter), sin copiar datos.
const C: any = (chrome as any)[lang] ?? (chrome as any).es;
const t: any = (ui as any)[lang] ?? (ui as any).es;
const F = C.footer;
const units: any[] = C.units ?? [];
const unitsPage: string = C.anchors['#unidades'];
const LANGS = ['es', 'ca', 'en', 'fr', 'ru', 'uk'];
const NAME: Record<string, string> = { es: 'Español', ca: 'Català', en: 'English', fr: 'Français', ru: 'Русский', uk: 'Українська' };
// en la portada la valoración se pide en su propio formulario (#formulario); fuera de ella, #info → /contacto/#form
const ctaHref = '#formulario';
const entorno = import.meta.env.PUBLIC_ENTORNO ?? 'preview';
const chevron = '<svg class="pl-chev" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>';
const [a1, a2] = F.addr.split(/,\s*(?=\d{5})/);
const cyr = lang === 'ru' || lang === 'uk';
const fonts = `https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Lato:wght@300;400;700;900${cyr ? '&family=Open+Sans:wght@300;400;700' : ''}&display=swap`;

const slides = [
  { src: `${IMG}/hero-playa.webp`, pos: '60% 30%' },
  { src: `${IMG}/hero-cuerpo.webp`, pos: '70% 30%' },
  { src: `${IMG}/hero-perfil.webp`, pos: '70% 20%' },
  { src: `${IMG}/hero-facial.webp`, pos: '70% 25%' },
];

const reelsBase = [
  { img: 'reel-pecho-sin-protesis', href: 'https://www.instagram.com/p/DZu3tjeFKb_/' },
  { img: 'reel-no-creamos-una-clinica', href: 'https://www.instagram.com/p/DYwpKEKChIH/' },
  { img: 'reel-preserve', href: 'https://www.instagram.com/p/Davz27-uXQo/' },
  { img: 'reel-lipedema', href: 'https://www.instagram.com/p/DcRocCzmAcS/' },
  { img: 'reel-capilar', href: 'https://www.instagram.com/p/DbIg1hom6M5/' },
  { img: 'reel-equipo', href: 'https://www.instagram.com/p/DYMb5EvEnoK/' },
];
const reels = reelsBase.map((x, i) => ({ ...x, ...d.reels.items[i] }));

const tratBase = [
  { img: 't-aumento-pecho', href: U.aumento, ic: 'heart' },
  { img: 't-liposuccion', href: U.liposuccion, ic: 'spark' },
  { img: 't-abdominoplastia', href: U.abdomino, ic: 'pulse' },
  { img: 't-rinoplastia', href: U.rino, ic: 'frame' },
  { img: 't-obesidad', href: U.obesidad, ic: 'scale' },
  { img: 't-facial', href: U.facial, ic: 'face' },
];
const trat = tratBase.map((x, i) => ({ ...x, t: d.trat[i] }));

const equipoBase = [
  { f: false, n: 'Mike Dewever', img: 'dr-mike-dewever' },
  { f: true, n: 'Marel Gómez', img: 'dr-marel-gomez' },
  { f: true, n: 'Ainitze Ibarzabal', img: 'dra-ainitze-ibarzabal' },
  { f: false, n: 'Valentí Puig Diví', img: 'dr-valenti-puig' },
  { f: false, n: 'Cristóbal Langdon Montero', img: 'dr-cristobal-langdon' },
  { f: false, n: 'Sergio Ángeles Montañez', img: 'dr-sergio-angeles' },
  { f: false, n: 'David Pérez Asensio', img: 'dr-david-perez' },
  { f: true, n: 'Claudia Vera Ching', img: 'dra-claudia-vera' },
];
const equipo = equipoBase.map((x, i) => ({ n: `${x.f ? d.team.dra : d.team.dr} ${x.n}`, r: d.team.roles[i], img: x.img }));

const todos = unidades.unidades.flatMap((u: any) => u.links).filter((l: any, i: number, a: any[]) => a.findIndex((x: any) => x.href === l.href) === i);

const icons: Record<string, string> = {
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  pulse: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  frame: '<path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/>',
  scale: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9a4 4 0 0 1 6 0l-2 3"/>',
  face: '<circle cx="12" cy="9" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/>',
  star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  shield: '<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  pin: '<path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrow: '<path d="m9 6 6 6-6 6"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  doc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  play: '<path d="M8 5v14l11-7z" fill="currentColor"/>',
};
const svg = (k: string, s = 18) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[k]}</svg>`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{d.htmlTitle}</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fonts} />
  <link rel="preload" as="image" href={slides[0].src} />
  <ConsentMode />
  {entorno !== 'preview' && site.gtm && (
    <script is:inline define:vars={{ id: site.gtm }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
    </script>
  )}
</head>
<body class="pl">

<header class="pl-head" id="top">
  <div class="pl-topbar">
    <p>{d.topbar}</p>
    <a class="pl-topbar-tel" href={TEL}>972 20 90 86</a>
  </div>
  <div class="pl-nav">
    <a class="pl-logo" href={C.home}><img src={site.logo} alt="Médics Integral Salut" width="200" height="79" /></a>
    <nav class="pl-menu" aria-label={t.menu}>
      <a href={C.home} aria-current="page">{t.home}</a>
      {C.menu.map((i: any, n: number) => n === 2 && units.length
        ? <button type="button" class="pl-units-btn" aria-expanded="false" aria-controls="pl-mega">{i.text}<Fragment set:html={chevron} /></button>
        : <a href={i.href.startsWith('#') ? C.anchors[i.href] : i.href}>{i.text}</a>)}
    </nav>
    <div class="pl-hacc">
      <div class="pl-langsel">
        <button type="button" class="pl-lang-btn" aria-expanded="false" aria-controls="pl-langs" aria-label={`${t.lang}: ${NAME[lang]}`}>
          <Bandera l={lang} /><span>{lang.toUpperCase()}</span><Fragment set:html={chevron} />
        </button>
        <ul class="pl-lang-list" id="pl-langs" hidden>
          {LANGS.map((l) => <li><a href={(chrome as any)[l].home} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}><Bandera l={l} />{NAME[l]}</a></li>)}
        </ul>
      </div>
      <a class="pl-btn pl-nav-cta" href={ctaHref}>{C.cta.text}</a>
    </div>
    <button class="pl-burger" id="pl-burger" type="button" aria-label={t.menu_open} aria-controls="pl-panel" aria-expanded="false"><i></i><i></i><i></i></button>
  </div>
  {units.length > 0 && (
    <div class="pl-mega" id="pl-mega" hidden>
      <div class="pl-wrap">
        <a class="pl-mega-all" href={unitsPage}>{C.menu[2].text} →</a>
        <div class="pl-mega-grid">
          {units.map((u: any) => (
            <div class="pl-mega-col">
              {u.href ? <a class="pl-mega-cat" href={u.href}>{u.text}</a> : <span class="pl-mega-cat">{u.text}</span>}
              {u.sub && <ul>{u.sub.map((x: any) => (
                <li><a href={x.href}>{x.text}</a>{x.sub && <ul class="pl-mega-sub">{x.sub.map((y: any) => <li><a href={y.href}>{y.text}</a></li>)}</ul>}</li>
              ))}</ul>}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</header>
<div class="pl-velo" id="pl-velo"></div>
<nav class="pl-panel" id="pl-panel" aria-label={t.menu}>
  <a href={C.home}>{t.home}</a>
  {C.menu.map((i: any, n: number) => n === 2 && units.length ? (
    <details class="pl-p-units">
      <summary>{i.text}</summary>
      <a class="pl-p-cat" href={unitsPage}>{i.text}</a>
      {units.map((u: any) => <>
        <a class="pl-p-cat" href={u.href}>{u.text}</a>
        {u.sub?.map((x: any) => <>
          <a class="pl-p-sub" href={x.href}>{x.text}</a>
          {x.sub?.map((y: any) => <a class="pl-p-sub pl-p-sub2" href={y.href}>{y.text}</a>)}
        </>)}
      </>)}
    </details>
  ) : <a href={i.href.startsWith('#') ? C.anchors[i.href] : i.href}>{i.text}</a>)}
  <a class="pl-btn" href={ctaHref}>{C.cta.text}</a>
  <a class="pl-btn-line" href={WA} target="_blank" rel="noopener">WhatsApp 620 892 236</a>
  <ul class="pl-p-langs" aria-label={t.lang}>
    {LANGS.map((l) => <li><a href={(chrome as any)[l].home} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}><Bandera l={l} />{NAME[l]}</a></li>)}
  </ul>
</nav>

<main>
<!-- 1 · HERO -->
<section class="pl-hero" aria-label="Medics Integral Salut">
  <div class="pl-hero-bg" aria-hidden="true">
    {slides.map((s, i) => <img class:list={['pl-slide', i === 0 && 'on']} src={s.src} alt="" style={`object-position:${s.pos}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />)}
  </div>
  <div class="pl-wrap pl-hero-in">
    <span class="pl-badge" set:html={`${svg('pin', 12)} ${fmt(d.badge)}`} />
    <h1 set:html={d.heroH1} />
    <p class="pl-lead">{d.heroLead}</p>
    <div class="pl-ctas">
      <a class="pl-btn pl-btn-lg" href="#formulario">{d.heroCta} <span set:html={svg('arrow', 16)} /></a>
      <a class="pl-btn-line" href={TEL}><span set:html={svg('phone', 16)} /> 972 20 90 86</a>
    </div>
    <ul class="pl-trust">
      <li><span class="pl-stars">★★★★★</span> {fmt(d.trust[0])}</li>
      <li set:html={`${svg('check', 15)} ${fmt(d.trust[1])}`} />
      <li set:html={`${svg('shield', 15)} ${fmt(d.trust[2])}`} />
    </ul>
  </div>
</section>

<!-- 2 · CIFRAS -->
<section class="pl-cifras">
  <div class="pl-wrap pl-cifras-in">
    <div><span class="pl-ic" set:html={svg('clock')} /><b>{r.since}</b><span>{d.cifras[0]}</span></div>
    <div><span class="pl-ic" set:html={svg('face')} /><b>{equipo.length}</b><span>{d.cifras[1]}</span></div>
    <div><span class="pl-ic" set:html={svg('star')} /><b>{nota}<i>★</i></b><span>{d.cifras[2]}</span></div>
    <div><span class="pl-ic" set:html={svg('check')} /><b>{r.count}+</b><span>{d.cifras[3]}</span></div>
  </div>
</section>

<!-- 3 · REELS (la sección que gustó de la propuesta anterior) -->
<section class="pl-reels" id="videos">
  <div class="pl-wrap">
    <div class="pl-reels-head">
      <div>
        <span class="pl-kick">{d.reels.kick}</span>
        <h2 set:html={d.reels.h2} />
        <p>{d.reels.p}</p>
      </div>
      <a class="pl-btn-dark" href="https://www.instagram.com/medicsintegralsalut/" target="_blank" rel="noopener">@medicsintegralsalut</a>
    </div>
    <div class="pl-reels-row">
      {reels.map((x) => (
        <a class="pl-reel" href={x.href} target="_blank" rel="noopener">
          <img src={`${IMG}/${x.img}.webp`} alt="" width="360" height="640" loading="lazy" />
          <i>{x.tag}</i>
          <span class="pl-play" set:html={svg('play', 18)} />
          <span class="pl-reel-t">{x.t}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- 4 · ELIGE TU TRATAMIENTO -->
<section class="pl-sel" id="tratamientos">
  <div class="pl-wrap">
    <div class="pl-title pl-center"><span class="pl-line" /><span class="pl-kick">{d.sel.kick}</span><h2 class="pl-h2s">{d.sel.h2}</h2></div>
    <div class="pl-sel-row">
      {trat.map((x) => <a href={x.href}><span set:html={svg(x.ic, 20)} />{x.t}</a>)}
    </div>
  </div>
</section>

<!-- 5 · POR QUÉ ELEGIRNOS -->
<section class="pl-why">
  <div class="pl-why-txt">
    <span class="pl-kick pl-kick-o">{d.why.kick}</span>
    <h2 set:html={d.why.h2} />
    <p>{d.why.p}</p>
    <ol class="pl-why-list">
      {clinica.ventajas.map((v: any, i: number) => (
        <li class:list={[i === 0 && 'on']}><span>{String(i + 1).padStart(2, '0')}</span><div><b>{v.t}</b><small set:html={v.d} /></div></li>
      ))}
    </ol>
    <a class="pl-btn" href="#formulario">{d.why.cta} <span set:html={svg('arrow', 16)} /></a>
  </div>
  <div class="pl-why-img"><img src={`${IMG}/por-que.webp`} alt={d.why.imgAlt} loading="lazy" /></div>
</section>

<!-- 6 · LAS MÁS SOLICITADAS -->
<section class="pl-mas">
  <div class="pl-wrap">
    <div class="pl-title"><span class="pl-kick">{d.mas.kick}</span><h2 set:html={d.mas.h2} />
      <p>{d.mas.p}</p></div>
    <div class="pl-mas-grid">
      {trat.map((x, i) => (
        <a class="pl-card" href={x.href}>
          <img src={`${IMG}/${x.img}.webp`} alt={x.t} loading="lazy" width="600" height="898" />
          <span class="pl-card-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="pl-card-t"><b>{x.t}</b><small>{d.mas.ver}</small></span>
        </a>
      ))}
    </div>
    <p class="pl-center"><a class="pl-btn-ghost" href={U.unidades}>{d.mas.all}</a></p>
  </div>
</section>

<!-- 7 · VÍDEO DEL EQUIPO -->
<section class="pl-video">
  <div class="pl-video-txt">
    <span class="pl-kick pl-kick-o">{d.video.kick}</span>
    <h2 set:html={d.video.h2} />
    <p>{d.video.p}</p>
    <ol class="pl-mini">
      {d.video.list.map((t: string, i: number) => <li><span>{String(i + 1).padStart(2, '0')}</span>{t}</li>)}
    </ol>
    <a class="pl-btn" href="#formulario">{d.video.cta} <span set:html={svg('arrow', 16)} /></a>
  </div>
  <div class="pl-video-media">
    <video src={`${IMG}/quirofano.mp4`} poster={`${IMG}/poster-quirofano.webp`} muted loop playsinline preload="none" data-auto></video>
    <span class="pl-video-cap">{d.video.cap}<br /><b>Médics Integral Salut</b></span>
  </div>
</section>

<!-- 8 · PRIMERA VISITA -->
<section class="pl-visita">
  <div class="pl-wrap">
    <div class="pl-title pl-center pl-light"><span class="pl-line" /><span class="pl-kick">{d.visita.kick}</span><h2>{d.visita.h2}</h2></div>
    <div class="pl-visita-grid">
      <div><span class="pl-num">01</span><span class="pl-ic-sq" set:html={svg('chat', 16)} /><h3>{d.visita.items[0].t}</h3><p>{d.visita.items[0].d}</p></div>
      <div><span class="pl-num">02</span><span class="pl-ic-sq" set:html={svg('doc', 16)} /><h3>{d.visita.items[1].t}</h3><p>{d.visita.items[1].d}</p></div>
      <div><span class="pl-num">03</span><span class="pl-ic-sq" set:html={svg('heart', 16)} /><h3>{d.visita.items[2].t}</h3><p>{d.visita.items[2].d}</p></div>
    </div>
    <p class="pl-center"><a class="pl-btn" href="#formulario">{d.visita.cta} <span set:html={svg('arrow', 16)} /></a></p>
  </div>
</section>

<!-- 9 · LA DOCTORA RESPONDE -->
<section class="pl-faq">
  <div class="pl-wrap pl-faq-in">
    <div class="pl-title"><span class="pl-kick">{doctora.kicker}</span><h2>{doctora.heading}</h2>
      <p>{d.faqP}</p></div>
    <div class="pl-acc">
      {doctora.items.map((q: any, i: number) => (
        <details open={i === 0}><summary><span>{String(i + 1).padStart(2, '0')}</span>{q.q}</summary><p>{q.a}</p></details>
      ))}
    </div>
  </div>
</section>

<!-- 10 · OPINIONES -->
<section class="pl-ops">
  <div class="pl-wrap">
    <div class="pl-ops-head">
      <span class="pl-kick">{d.ops.kick}</span>
      <div class="pl-ops-score"><b>{nota}</b><span><span class="pl-stars">★★★★★</span><small>{fmt(d.ops.reviews)}</small></span></div>
    </div>
    <div class="pl-ops-card">
      <span class="pl-quote">“</span>
      {historias.items.map((h: any, i: number) => (
        <figure class:list={['pl-op', i === 0 && 'on']}>
          <span class="pl-stars">★★★★★</span>
          <blockquote>{d.ops.open}{h.quote}{d.ops.close}</blockquote>
          <figcaption><span class="pl-ava">{h.name[0]}</span><span><b>{h.name}</b><small>{h.label} · {h.source}</small></span><em>{d.ops.google}</em></figcaption>
        </figure>
      ))}
      <div class="pl-dots">{historias.items.map((_: any, i: number) => <button type="button" aria-label={fmt(d.ops.aria, { n: i + 1 })} class:list={[i === 0 && 'on']} />)}</div>
    </div>
  </div>
</section>

<!-- 11 · EQUIPO -->
<section class="pl-team" id="equipo">
  <div class="pl-wrap">
    <div class="pl-title pl-center"><span class="pl-line" /><span class="pl-kick">{d.team.kick}</span><h2>{d.team.h2}</h2>
      <p>{d.team.p}</p></div>
    <div class="pl-team-box">
      <ol class="pl-team-list">
        {equipo.map((m, i) => (
