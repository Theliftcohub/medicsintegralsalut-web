  <div class="pl-wrap pl-foot-legal"><span>© {new Date().getFullYear()} {F.brand}</span><span><a href={unitsPage}>{C.menu[2].text}</a><a href={F.fin}>{F.finTitle}</a></span></div>
</footer>

<a class="pl-wa" href={WA} target="_blank" rel="noopener" aria-label="WhatsApp"><svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.9-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3z"/></svg></a>

<Consent lang={lang} />

<script>
  // Hero: fundido entre fotos
  const sl = [...document.querySelectorAll<HTMLElement>('.pl-slide')];
  let k = 0;
  if (sl.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches)
    setInterval(() => { sl[k].classList.remove('on'); k = (k + 1) % sl.length; sl[k].classList.add('on'); }, 5500);
  // Cabecera sólida al bajar (y mientras hay un desplegable o el menú móvil abiertos)
  const hd = document.querySelector<HTMLElement>('.pl-head')!;
  const burger = document.getElementById('pl-burger')!;
  const velo = document.getElementById('pl-velo')!;
  const panel = document.getElementById('pl-panel')!;
  const onS = () => hd.classList.toggle('solid', scrollY > 60);
  addEventListener('scroll', onS, { passive: true }); onS();
  const cerrarMenu = () => { document.body.classList.remove('pl-menu-open'); burger.setAttribute('aria-expanded', 'false'); };
  burger.addEventListener('click', () => {
    const a = document.body.classList.toggle('pl-menu-open');
    burger.setAttribute('aria-expanded', a ? 'true' : 'false');
  });
  velo.addEventListener('click', cerrarMenu);
  panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) cerrarMenu(); });
  // Desplegables (Unidades e idioma): clic, teclado y, con ratón, al pasar por encima
  type Drop = { btn: HTMLElement; box: HTMLElement; set: (o: boolean) => void };
  const drops: Drop[] = [];
  const drop = (btn: HTMLElement | null, box: HTMLElement | null, hover: boolean) => {
    if (!btn || !box) return;
    let timer: number;
    const set = (open: boolean) => {
      clearTimeout(timer); box.hidden = !open; btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      hd.classList.toggle('drop-open', drops.some((x) => !x.box.hidden));
    };
    const me: Drop = { btn, box, set }; drops.push(me);
    btn.addEventListener('click', (e) => { e.stopPropagation(); const open = box.hidden; drops.forEach((o) => o.set(false)); set(open); });
    if (hover && matchMedia('(hover:hover) and (pointer:fine)').matches)
      [btn, box].forEach((el) => {
        el.addEventListener('mouseenter', () => { drops.forEach((o) => { if (o !== me) o.set(false); }); set(true); });
        el.addEventListener('mouseleave', () => { clearTimeout(timer); timer = window.setTimeout(() => set(false), 220); });
      });
  };
  drop(hd.querySelector('.pl-units-btn'), document.getElementById('pl-mega'), true);
  drop(hd.querySelector('.pl-lang-btn'), document.getElementById('pl-langs'), false);
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.pl-mega,.pl-langsel')) drops.forEach((o) => o.set(false)); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    cerrarMenu();
    const abierto = drops.find((o) => !o.box.hidden);
    drops.forEach((o) => o.set(false));
    abierto?.btn.focus();
  });
  addEventListener('resize', () => { if (innerWidth > 1180) cerrarMenu(); });
  // «Por qué elegirnos»: punto activo
  document.querySelectorAll('.pl-why-list li').forEach((li) => li.addEventListener('mouseenter', () => {
    document.querySelectorAll('.pl-why-list li').forEach((x) => x.classList.toggle('on', x === li));
  }));
  // Equipo: lista ↔ foto
  const tb = [...document.querySelectorAll<HTMLButtonElement>('.pl-team-list button')];
  const tf = [...document.querySelectorAll<HTMLElement>('.pl-team-photo figure')];
  tb.forEach((b) => b.addEventListener('click', () => {
    tb.forEach((x) => x.classList.toggle('on', x === b));
    tf.forEach((f) => f.classList.toggle('on', f.dataset.i === b.dataset.i));
  }));
  // Opiniones: carrusel
  const ops = [...document.querySelectorAll('.pl-op')];
  const dots = [...document.querySelectorAll('.pl-dots button')];
  let o = 0;
  const show = (n: number) => { o = n; ops.forEach((x, i) => x.classList.toggle('on', i === n)); dots.forEach((x, i) => x.classList.toggle('on', i === n)); };
  dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
  setInterval(() => show((o + 1) % ops.length), 7000);
  // Vídeo: solo se carga y reproduce cuando entra en pantalla
  const v = document.querySelector<HTMLVideoElement>('video[data-auto]');
  if (v) new IntersectionObserver(([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }, { threshold: .3 }).observe(v);
  // Aparición suave
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
  document.querySelectorAll('main > section:not(.pl-hero)').forEach((s) => { s.classList.add('rv'); io.observe(s); });
</script>
</body>
</html>
