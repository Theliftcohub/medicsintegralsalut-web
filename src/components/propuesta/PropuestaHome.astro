---
// Portada (07/10/2026) con el estilo de la landing /clinica/ (petición del cliente; diseño de Oscar)
// + la sección de reels de Instagram que le gustó de la propuesta anterior.
// Componente único para los 6 idiomas (prop `lang`): textos propios en src/data/propuesta-i18n.json;
// los bloques que ya existen en la home.json de cada idioma (pt-clinica, pt-unidades, ps-doctora,
// ps-historias, pt-contacto, pt-texto, ps-pedidos) se leen de ahí. Datos de negocio de site.json.
// Solo el CONTENIDO: lo pinta [...slug].astro dentro de Base.astro, que pone el <head> SEO de home.json (title,
// description, canonical, robots, hreflang, JSON-LD), la cabecera y el pie de toda la web, GTM y el banner de cookies.
// Fuentes alojadas en la web (@fontsource, sin Google Fonts); el mapa de fondo solo se carga con consentimiento.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/open-sans/300.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/700.css';
import '../../styles/propuesta-home.css';
import NativeForm from '../NativeForm.astro';
import site from '../../data/site.json';
import dict from '../../data/propuesta-i18n.json';
import testi from '../../data/propuesta-testimonios.json';
import homeEs from '../../content/pages/es/home.json';
import homeCa from '../../content/pages/ca/home.json';
import homeEn from '../../content/pages/en/home.json';
import homeFr from '../../content/pages/fr/home.json';
import homeRu from '../../content/pages/ru/home.json';
import homeUk from '../../content/pages/uk/home.json';

const { lang = 'es' } = Astro.props as { lang?: 'es' | 'ca' | 'en' | 'fr' | 'ru' | 'uk' };
const homes: Record<string, any> = { es: homeEs, ca: homeCa, en: homeEn, fr: homeFr, ru: homeRu, uk: homeUk };
const home = homes[lang];
const d = (dict as any)[lang];
const U = d.urls;
// Historias reales de pacientes (Instagram). Datos compactos en src/data/propuesta-testimonios.json; textos en d.hist.
// mostrarObesidad (en ese JSON) = botón «Obesidad» pendiente de confirmar por el cliente: ponlo a false para ocultarlo y sus tarjetas.
const H = d.hist;
const MOSTRAR_OBESIDAD: boolean = testi.mostrarObesidad;
const hItems = (testi.items as any[]).filter((x) => MOSTRAR_OBESIDAD || x.c !== 'obesidad');
const hCount = (k: string) => hItems.filter((x) => (k === 'todas' ? x.c !== 'obesidad' : x.c === k)).length;
const hKeys = ['todas', ...(testi.orden as string[]), ...(MOSTRAR_OBESIDAD ? ['obesidad'] : [])].filter((k) => hCount(k) > 0);
const hFirst = new Set(hItems.filter((x) => x.c !== 'obesidad').slice(0, 6).map((x) => x.s));

const B = (t: string) => home.blocks.find((b: any) => b.type === t) as any;
const clinica = B('pt-clinica');
const unidades = B('pt-unidades');
const doctora = B('ps-doctora');
const historias = B('ps-historias');
const contacto = B('pt-contacto');
// textos SEO literales de la portada anterior (se conservan en la sección «pl-seo»)
const texto = B('pt-texto');
const seoParas: string[] = [...(clinica.paras ?? []), ...(B('ps-pedidos')?.intro ?? []), ...(clinica.extra ?? [])];
const r = site.rating;
const nota = String(r.value).replace('.', lang === 'en' ? '.' : ',');
const anios = new Date().getFullYear() - r.since;
const IMG = '/propuesta';
const WA = 'https://api.whatsapp.com/send?phone=34620892236';
const TEL = 'tel:+34972209086';
const fmt = (s: string, v: Record<string, string | number> = {}) =>
  Object.entries({ since: r.since, nota, count: r.count, anios, ...v }).reduce((a, [k, x]) => a.split(`{${k}}`).join(String(x)), s);

// Hero: carrusel de 3 fotos de Girona y la Costa Brava (petición del cliente 07/10/2026), cada una con su titular, línea en
// cursiva y frase (src/data/propuesta-i18n.json → hero.slides). El titular de la 1.ª es el H1 de la portada (d.heroH1).
// Cada foto tiene encuadre horizontal (1280/1920) y vertical recortado alrededor del motivo (-movil-640/1080) para móvil y
// tablet en vertical (≤820 px). En móvil, sizes declara el 60 % del ancho: los de densidad 2,6-3 bajan la de 640 px (LCP).
const slides = [
  { n: 'hero-onyar', h: 853, mv: [640, 1080], pos: '45% 55%', posM: '50% 50%' },
  { n: 'hero-sant-feliu', h: 720, mv: [640, 771], pos: '70% 45%', posM: '50% 50%' },
  { n: 'hero-onyar-persona', h: 720, mv: [640, 771], pos: '72% 40%', posM: '50% 40%' },
].map((x) => ({
  ...x,
  src: `${IMG}/${x.n}-1280.webp`,
  srcset: `${IMG}/${x.n}-1280.webp 1280w, ${IMG}/${x.n}-1920.webp 1920w`,
  srcsetM: `${IMG}/${x.n}-movil-640.webp ${x.mv[0]}w, ${IMG}/${x.n}-movil-1080.webp ${x.mv[1]}w`,
}));

const reelsBase = [
  { img: 'reel-pecho-sin-protesis', href: 'https://www.instagram.com/p/DZu3tjeFKb_/' },
  { img: 'reel-no-creamos-una-clinica', href: 'https://www.instagram.com/p/DYwpKEKChIH/' },
  { img: 'reel-preserve', href: 'https://www.instagram.com/p/Davz27-uXQo/' },
  { img: 'reel-lipedema', href: 'https://www.instagram.com/p/DcRocCzmAcS/' },
  { img: 'reel-capilar', href: 'https://www.instagram.com/p/DbIg1hom6M5/' },
  { img: 'reel-equipo', href: 'https://www.instagram.com/p/DYMb5EvEnoK/' },
];
const reels = reelsBase.map((x, i) => ({ ...x, ...d.reels.items[i] }));

const tratBase = [
  { img: 't-aumento-pecho', href: U.aumento, ic: 'heart' },
  { img: 't-liposuccion', href: U.liposuccion, ic: 'spark' },
  { img: 't-abdominoplastia', href: U.abdomino, ic: 'pulse' },
  { img: 't-rinoplastia', href: U.rino, ic: 'frame' },
  { img: 't-obesidad', href: U.obesidad, ic: 'scale' },
  { img: 't-facial', href: U.facial, ic: 'face' },
];
const trat = tratBase.map((x, i) => ({ ...x, t: d.trat[i] }));

const equipoBase = [
  { f: false, n: 'Mike Dewever', img: 'dr-mike-dewever' },
  { f: true, n: 'Marel Gómez', img: 'dr-marel-gomez' },
  { f: true, n: 'Ainitze Ibarzabal', img: 'dra-ainitze-ibarzabal' },
  { f: false, n: 'Valentí Puig Diví', img: 'dr-valenti-puig' },
  { f: false, n: 'Cristóbal Langdon Montero', img: 'dr-cristobal-langdon' },
  { f: false, n: 'Sergio Ángeles Montañez', img: 'dr-sergio-angeles' },
  { f: false, n: 'David Pérez Asensio', img: 'dr-david-perez' },
  { f: true, n: 'Claudia Vera Ching', img: 'dra-claudia-vera' },
];
const equipo = equipoBase.map((x, i) => ({ n: `${x.f ? d.team.dra : d.team.dr} ${x.n}`, r: d.team.roles[i], img: x.img }));
// textos del hero (cifras reales: site.json y número de médicos del equipo)
const hs = (d.hero.slides as any[]).map((x, i) => ({ ...x, t: i === 0 ? d.heroH1 : fmt(x.t, { equipo: equipo.length }), t2: fmt(x.t2), p: fmt(x.p, { equipo: equipo.length }).replace('★', '<span class="pl-stars">★</span>') }));

const todos = unidades.unidades.flatMap((u: any) => u.links).filter((l: any, i: number, a: any[]) => a.findIndex((x: any) => x.href === l.href) === i);

const icons: Record<string, string> = {
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  pulse: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  frame: '<path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/>',
  scale: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9a4 4 0 0 1 6 0l-2 3"/>',
  face: '<circle cx="12" cy="9" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/>',
  star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  shield: '<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  pin: '<path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrow: '<path d="m9 6 6 6-6 6"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  doc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  play: '<path d="M8 5v14l11-7z" fill="currentColor"/>',
};
const svg = (k: string, s = 18) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[k]}</svg>`;
---
<div class="pl pl-home">
<!-- 1 · HERO: carrusel interactivo (pestañas con progreso, flechas del teclado, deslizar en móvil, pausa) -->
<section class="pl-hero" aria-roledescription="carrusel" aria-label={d.hero.aria}>
  <div class="pl-hero-bg" aria-hidden="true">
    {slides.map((s, i) => (
      <picture class:list={['pl-slide', i === 0 && 'on']}>
        {i === 0
          ? <source media="(max-width: 820px)" srcset={s.srcsetM} sizes="60vw" />
          : <source media="(max-width: 820px)" data-srcset={s.srcsetM} sizes="60vw" />}
        {i === 0
          ? <img src={s.src} srcset={s.srcset} sizes="100vw" width="1280" height={s.h} alt="" fetchpriority="high" decoding="async" style={`--pos:${s.pos};--pos-m:${s.posM}`} />
          : <img data-src={s.src} data-srcset={s.srcset} sizes="100vw" width="1280" height={s.h} alt="" decoding="async" style={`--pos:${s.pos};--pos-m:${s.posM}`} />}
      </picture>
    ))}
  </div>
  <div class="pl-wrap pl-hero-in">
    <div class="pl-hs-textos">
      {hs.map((x, i) => (
        <div class:list={['pl-hs-t', i === 0 && 'on']} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} / ${hs.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
          {i === 0 ? <h1 class="pl-ht" set:html={x.t} /> : <p class="pl-ht" set:html={x.t} />}
          <p class="pl-ht2">{x.t2}</p>
          <p class="pl-lead" set:html={x.p} />
        </div>
      ))}
    </div>
    <div class="pl-ctas">
      <a class="pl-btn pl-btn-lg" href="#formulario">{d.heroCta} <span set:html={svg('arrow', 16)} /></a>
      <a class="pl-btn-line" href={TEL}><span set:html={svg('phone', 16)} /> 972 20 90 86</a>
    </div>
    <div class="pl-hs-nav">
      {hs.map((x, i) => (
        <button type="button" class:list={['pl-hs-tab', i === 0 && 'on']} aria-label={d.hero.ir.replace('{n}', String(i + 1)) + ': ' + x.tab} aria-current={i === 0 ? 'true' : undefined}>
          <span class="pl-hs-bar"><i></i></span><b>{String(i + 1).padStart(2, '0')}</b><span class="pl-hs-lab">{x.tab}</span>
        </button>
      ))}
      <button type="button" class="pl-hs-pausa" aria-label={d.hero.pausa} data-pausa={d.hero.pausa} data-seguir={d.hero.seguir}><span aria-hidden="true"></span></button>
    </div>
  </div>
</section>

<!-- 2 · CIFRAS -->
<section class="pl-cifras">
  <div class="pl-wrap pl-cifras-in">
    <div><span class="pl-ic" set:html={svg('clock')} /><b>{r.since}</b><span>{d.cifras[0]}</span></div>
    <div><span class="pl-ic" set:html={svg('face')} /><b>{equipo.length}</b><span>{d.cifras[1]}</span></div>
    <div><span class="pl-ic" set:html={svg('star')} /><b>{nota}<i>★</i></b><span>{d.cifras[2]}</span></div>
    <div><span class="pl-ic" set:html={svg('check')} /><b>{r.count}+</b><span>{d.cifras[3]}</span></div>
  </div>
</section>

<!-- 3 · REELS (la sección que gustó de la propuesta anterior) -->
<section class="pl-reels" id="videos">
  <div class="pl-wrap">
    <div class="pl-reels-head">
      <div>
        <span class="pl-kick">{d.reels.kick}</span>
        <h2 set:html={d.reels.h2} />
        <p>{d.reels.p}</p>
      </div>
      <a class="pl-btn-dark" href="https://www.instagram.com/medicsintegralsalut/" target="_blank" rel="noopener">@medicsintegralsalut</a>
    </div>
    <div class="pl-reels-row">
      {reels.map((x) => (
        <a class="pl-reel" href={x.href} target="_blank" rel="noopener">
          <img src={`${IMG}/${x.img}.webp`} alt="" width="360" height="640" loading="lazy" />
          <i>{x.tag}</i>
          <span class="pl-play" set:html={svg('play', 18)} />
          <span class="pl-reel-t">{x.t}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- 4 · ELIGE TU TRATAMIENTO -->
<section class="pl-sel" id="tratamientos">
  <div class="pl-wrap">
    <div class="pl-title pl-center"><span class="pl-line" /><span class="pl-kick">{d.sel.kick}</span><h2 class="pl-h2s">{d.sel.h2}</h2></div>
    <div class="pl-sel-row">
      {trat.map((x) => <a href={x.href}><span set:html={svg(x.ic, 20)} />{x.t}</a>)}
    </div>
  </div>
</section>

<!-- 5 · POR QUÉ ELEGIRNOS -->
<section class="pl-why">
  <div class="pl-why-txt">
    <span class="pl-kick pl-kick-o">{d.why.kick}</span>
    <h2 set:html={d.why.h2} />
    <p>{d.why.p}</p>
    <ol class="pl-why-list">
      {clinica.ventajas.map((v: any, i: number) => (
        <li class:list={[i === 0 && 'on']}><span>{String(i + 1).padStart(2, '0')}</span><div><b>{v.t}</b><small set:html={v.d} /></div></li>
      ))}
    </ol>
    <a class="pl-btn" href="#formulario">{d.why.cta} <span set:html={svg('arrow', 16)} /></a>
  </div>
  <div class="pl-why-img"><img src={`${IMG}/por-que.webp`} alt={d.why.imgAlt} loading="lazy" /></div>
</section>

<!-- 6 · LAS MÁS SOLICITADAS -->
<section class="pl-mas">
  <div class="pl-wrap">
    <div class="pl-title"><span class="pl-kick">{d.mas.kick}</span><h2 set:html={d.mas.h2} />
      <p>{d.mas.p}</p></div>
    <div class="pl-mas-grid">
      {trat.map((x, i) => (
        <a class="pl-card" href={x.href}>
          <img src={`${IMG}/${x.img}.webp`} alt={x.t} loading="lazy" width="600" height="898" />
          <span class="pl-card-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="pl-card-t"><b>{x.t}</b><small>{d.mas.ver}</small></span>
        </a>
      ))}
    </div>
    <p class="pl-center"><a class="pl-btn-ghost" href={U.unidades}>{d.mas.all}</a></p>
  </div>
</section>

<!-- 7 · VÍDEO DEL EQUIPO -->
<section class="pl-video">
  <div class="pl-video-txt">
    <span class="pl-kick pl-kick-o">{d.video.kick}</span>
    <h2 set:html={d.video.h2} />
    <p>{d.video.p}</p>
    <ol class="pl-mini">
      {d.video.list.map((t: string, i: number) => <li><span>{String(i + 1).padStart(2, '0')}</span>{t}</li>)}
    </ol>
    <a class="pl-btn" href="#formulario">{d.video.cta} <span set:html={svg('arrow', 16)} /></a>
  </div>
  <div class="pl-video-media">
    <video data-src={`${IMG}/quirofano.mp4`} data-poster={`${IMG}/poster-quirofano.webp`} muted loop playsinline preload="none" data-auto></video>
    <span class="pl-video-cap">{d.video.cap}<br /><b>Médics Integral Salut</b></span>
  </div>
</section>

<!-- 8 · PRIMERA VISITA -->
<section class="pl-visita">
  <div class="pl-wrap">
    <div class="pl-title pl-center pl-light"><span class="pl-line" /><span class="pl-kick">{d.visita.kick}</span><h2>{d.visita.h2}</h2></div>
    <div class="pl-visita-grid">
      <div><span class="pl-num">01</span><span class="pl-ic-sq" set:html={svg('chat', 16)} /><h3>{d.visita.items[0].t}</h3><p>{d.visita.items[0].d}</p></div>
      <div><span class="pl-num">02</span><span class="pl-ic-sq" set:html={svg('doc', 16)} /><h3>{d.visita.items[1].t}</h3><p>{d.visita.items[1].d}</p></div>
      <div><span class="pl-num">03</span><span class="pl-ic-sq" set:html={svg('heart', 16)} /><h3>{d.visita.items[2].t}</h3><p>{d.visita.items[2].d}</p></div>
    </div>
    <p class="pl-center"><a class="pl-btn" href="#formulario">{d.visita.cta} <span set:html={svg('arrow', 16)} /></a></p>
  </div>
</section>

<!-- 9 · LA DOCTORA RESPONDE -->
<section class="pl-faq">
  <div class="pl-wrap pl-faq-in">
    <div class="pl-title"><span class="pl-kick">{doctora.kicker}</span><h2>{doctora.heading}</h2>
      <p>{d.faqP}</p></div>
    <div class="pl-acc">
      {doctora.items.map((q: any, i: number) => (
        <details open={i === 0}><summary><span>{String(i + 1).padStart(2, '0')}</span>{q.q}</summary><p>{q.a}</p></details>
      ))}
    </div>
  </div>
</section>

<!-- 10 · OPINIONES -->
<section class="pl-ops">
  <div class="pl-wrap">
    <div class="pl-ops-head">
      <span class="pl-kick">{d.ops.kick}</span>
      <div class="pl-ops-score"><b>{nota}</b><span><span class="pl-stars">★★★★★</span><small>{fmt(d.ops.reviews)}</small></span></div>
    </div>
    <div class="pl-ops-card">
      <span class="pl-quote">“</span>
      {historias.items.map((h: any, i: number) => (
        <figure class:list={['pl-op', i === 0 && 'on']}>
          <span class="pl-stars">★★★★★</span>
          <blockquote>{d.ops.open}{h.quote}{d.ops.close}</blockquote>
          <figcaption><span class="pl-ava">{h.name[0]}</span><span><b>{h.name}</b><small>{h.label} · {h.source}</small></span><em>{d.ops.google}</em></figcaption>
        </figure>
      ))}
      <div class="pl-dots">{historias.items.map((_: any, i: number) => <button type="button" aria-label={fmt(d.ops.aria, { n: i + 1 })} class:list={[i === 0 && 'on']} />)}</div>
    </div>
  </div>
</section>

<!-- 11 · EQUIPO -->
<section class="pl-team" id="equipo">
  <div class="pl-wrap">
    <div class="pl-title pl-center"><span class="pl-line" /><span class="pl-kick">{d.team.kick}</span><h2>{d.team.h2}</h2>
      <p>{d.team.p}</p></div>
    <div class="pl-team-box">
      <ol class="pl-team-list">
        {equipo.map((m, i) => (
          <li><button type="button" data-i={i} class:list={[i === 0 && 'on']}><span class="pl-tn">{String(i + 1).padStart(2, '0')}</span><img src={`${IMG}/${m.img}.webp`} alt="" width="44" height="44" loading="lazy" /><span><b>{m.n}</b><small>{m.r}</small></span></button></li>
        ))}
      </ol>
      <div class="pl-team-photo">
        {equipo.map((m, i) => (
          <figure class:list={[i === 0 && 'on']} data-i={i}>
            <img src={`${IMG}/${m.img}.webp`} alt={m.n} loading="lazy" />
            <figcaption><span class="pl-kick pl-kick-o">{m.r}</span><b>{m.n}</b><a href="#formulario">{d.team.cta}</a></figcaption>
          </figure>
        ))}
      </div>
    </div>
    <p class="pl-center"><a class="pl-btn-ghost" href={U.equipo}>{d.team.all}</a></p>
  </div>
</section>

<!-- 12 · SEGURIDAD -->
<section class="pl-seg">
  <img class="pl-seg-bg" src={`${IMG}/seguridad.webp`} alt="" loading="lazy" />
  <div class="pl-wrap pl-seg-in">
    <span class="pl-kick pl-kick-o">{d.seg.kick}</span>
    <h2>{d.seg.h2}</h2>
    <div class="pl-seg-pills">
      <span set:html={`${svg('shield', 15)} ${d.seg.pills[0]}`} />
      <span set:html={`${svg('check', 15)} ${d.seg.pills[1]}`} />
      <span set:html={`${svg('heart', 15)} ${d.seg.pills[2]}`} />
    </div>
    <div class="pl-logos">{site.distintivos.map((l: any) => <img src={l.src} alt={l.alt} width={l.w} height={l.h} loading="lazy" />)}</div>
  </div>
</section>

<!-- 12b · HISTORIAS REALES DE PACIENTES (testimonios de Instagram filtrables por cirugía) -->
<section class="pl-hist" id="historias" data-more={H.more} data-view={H.view} data-vtitle={H.vtitle} data-ig={`https://www.instagram.com/reel/`}>
  <div class="pl-wrap">
    <div class="pl-hist-head pl-center">
      <span class="pl-line"></span>
      <span class="pl-kick pl-kick-o">{H.kick}</span>
      <h2 set:html={H.h2} />
      <p>{H.p}</p>
    </div>
    <div class="pl-hfil" role="group" aria-label={H.group}>
      {hKeys.map((k) => (
        <button type="button" class:list={['pl-hf', k === 'todas' && 'on']} data-f={k} aria-pressed={k === 'todas' ? 'true' : 'false'}>
          {H.f[k]} <i>({hCount(k)})</i>{k === 'obesidad' && <em>{H.pend}</em>}
        </button>
      ))}
    </div>
    <div class="pl-hgrid" id="plhgrid" aria-live="polite">
      {hItems.map((x) => {
        const nombre = x.n ?? H.anon;
        const lab = H.l[x.c];
        return (
          <button type="button" class="pl-hc" data-c={x.c} data-id={x.s} data-n={nombre} data-l={lab} hidden={!hFirst.has(x.s)} aria-label={H.view.replace('{n}', nombre).replace('{l}', lab)}>
            <img src={`${IMG}/testimonios/${x.s}.webp`} alt="" loading="lazy" decoding="async" width="360" height="640" />
            <span class="pl-hc-dur">{x.d}</span>
            {x.c === 'obesidad' && <span class="pl-hc-o">{H.pendShort}</span>}
            <span class="pl-hc-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg></span>
            <span class="pl-hc-t"><small>{lab}</small><b>{nombre}</b></span>
          </button>
        );
      })}
    </div>
    <p class="pl-hempty" id="plhempty" hidden>{H.empty}</p>
    <div class="pl-hmore" id="plhmore"><button type="button" class="pl-btn-ghost" id="plhmorebtn">{H.more}</button></div>
    <p class="pl-hsrc">{H.src} <a href="https://www.instagram.com/medicsintegralsalut" target="_blank" rel="noopener">@medicsintegralsalut</a></p>
  </div>
  <dialog class="pl-hd" id="plhd" aria-label={H.dlg}>
    <div class="pl-hd-box">
      <div class="pl-hd-bar"><div><small id="plhdc"></small><b id="plhdn"></b></div><button type="button" class="pl-hx" id="plhx" aria-label={H.close}>&times;</button></div>
      <div id="plhdf"></div>
      <div class="pl-hd-gate" id="plhdg" hidden><p>{H.consent}</p><button type="button" class="pl-btn" id="plhdgb">{H.consentBtn}</button></div>
      <p class="pl-hd-foot"><a id="plhdl" href="https://www.instagram.com/medicsintegralsalut" target="_blank" rel="noopener">{H.ig}</a></p>
    </div>
  </dialog>
</section>

<!-- 13 · FORMULARIO -->
<section class="pl-form" id="formulario">
  <div class="pl-form-txt">
    <span class="pl-kick pl-kick-o">{d.form.kick}</span>
    <h2>{d.form.h2}</h2>
    <p>{d.form.p}</p>
    <ul>
      <li set:html={`${svg('check', 16)} ${d.form.list[0]}`} />
      <li set:html={`${svg('doc', 16)} ${d.form.list[1]}`} />
      <li set:html={`${svg('shield', 16)} ${d.form.list[2]}`} />
    </ul>
    <a class="pl-tel-big" href={TEL}><span set:html={svg('phone', 18)} /><span><small>{d.form.callDirect}</small>972 20 90 86</span></a>
  </div>
  <div class="pl-form-card" id="info">
    <h3>{contacto.titulo}</h3>
    <p class="pl-sub">{contacto.texto}</p>
    <NativeForm form={contacto.form} lang={lang} cls="pl-nform" btnClass="pl-btn pl-btn-full" campos={true} />
    <p class="pl-legal" set:html={contacto.legal} />
  </div>
</section>

<!-- 14 · CONTACTO / MAPA -->
<section class="pl-map" id="contacto">
  <div class="pl-map-bg" aria-hidden="true" data-title={d.map.title} data-src={`https://maps.google.com/maps?q=Pla%C3%A7a+Poeta+Marquina+3%2C+17002+Girona&z=16&hl=${lang}&output=embed`}></div>
  <div class="pl-map-in">
    <span class="pl-line" /><span class="pl-kick">{d.map.kick}</span>
    <h2>{d.map.h2}</h2>
    <div class="pl-map-grid">
      <div><span class="pl-ic-sq" set:html={svg('pin', 16)} /><small>{d.map.address}</small><p>Plaça Poeta Marquina, 3<br />17002 Girona</p></div>
      <div><span class="pl-ic-sq" set:html={svg('phone', 16)} /><small>{d.map.phone}</small><p><a href={TEL}><b>972 20 90 86</b></a></p></div>
      <div><span class="pl-ic-sq" set:html={svg('clock', 16)} /><small>{d.map.hours}</small><p set:html={d.map.hoursText} /></div>
    </div>
    <div class="pl-ctas pl-center">
      <a class="pl-btn" href="#formulario">{d.map.cta} <span set:html={svg('arrow', 16)} /></a>
      <a class="pl-btn-line" href={WA} target="_blank" rel="noopener">{d.map.wa}</a>
    </div>
  </div>
</section>

<!-- 14b · TEXTO DE LA CLÍNICA (literal de la portada anterior: se conserva por SEO) -->
<section class="pl-seo">
  <div class="pl-wrap pl-seo-in">
    <div>
      <span class="pl-kick">{clinica.kicker}</span>
      {seoParas.map((p) => <p set:html={p} />)}
    </div>
    {texto && <div>
      <span class="pl-kick pl-kick-o">{texto.kicker}</span>
      <h2 class="pl-h2s">{texto.heading}</h2>
      {texto.paras.map((p: string) => <p set:html={p} />)}
    </div>}
  </div>
</section>

<!-- 15 · TODOS LOS TRATAMIENTOS -->
<section class="pl-todos">
  <div class="pl-wrap">
    <div class="pl-title pl-center"><span class="pl-line" /><span class="pl-kick">{d.todos.kick}</span><h2 class="pl-h2s">{d.todos.h2}</h2></div>
    <div class="pl-chips">{todos.map((l: any) => <a href={l.href}>{l.text}</a>)}</div>
  </div>
</section>
</div>

<script>
  // Hero: carrusel. Solo la 1.ª foto se descarga al entrar (imagen principal); las demás cuando la página ha cargado.
  // Avanza al terminar la barra de progreso de la pestaña activa (animación CSS); se pausa con el botón, al apuntar o
  // enfocar las pestañas y fuera de pantalla; sin avance automático con «reducir movimiento». Flechas del teclado y deslizar.
  const hero = document.querySelector<HTMLElement>('.pl-hero')!;
  const sl = [...hero.querySelectorAll<HTMLElement>('.pl-slide')];
  const tx = [...hero.querySelectorAll<HTMLElement>('.pl-hs-t')];
  const tabs = [...hero.querySelectorAll<HTMLButtonElement>('.pl-hs-tab')];
  const pausa = hero.querySelector<HTMLButtonElement>('.pl-hs-pausa')!;
  let k = 0;
  const cargarFotos = () => hero.querySelectorAll<HTMLElement>('[data-srcset]').forEach((el) => {
    (el as HTMLImageElement).srcset = el.dataset.srcset!; el.removeAttribute('data-srcset');
    if (el.dataset.src) { (el as HTMLImageElement).src = el.dataset.src; el.removeAttribute('data-src'); }
  });
  const ir = (n: number) => {
    cargarFotos();
    k = (n + sl.length) % sl.length;
    sl.forEach((x, i) => x.classList.toggle('on', i === k));
    tx.forEach((x, i) => { x.classList.toggle('on', i === k); if (i === k) x.removeAttribute('aria-hidden'); else x.setAttribute('aria-hidden', 'true'); });
    tabs.forEach((b, i) => { b.classList.toggle('on', i === k); if (i === k) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
  };
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => ir(i));
    b.querySelector('i')!.addEventListener('animationend', () => { if (b.classList.contains('on')) ir(k + 1); });
  });
  hero.querySelector('.pl-hs-nav')!.addEventListener('keydown', (e) => {
    const t = (e as KeyboardEvent).key;
    if (t === 'ArrowRight' || t === 'ArrowLeft') { e.preventDefault(); ir(k + (t === 'ArrowRight' ? 1 : -1)); tabs[k].focus(); }
  });
  pausa.addEventListener('click', () => {
    const parado = hero.classList.toggle('pl-hs-parado');
    pausa.setAttribute('aria-label', parado ? pausa.dataset.seguir! : pausa.dataset.pausa!);
  });
  let x0 = 0, y0 = 0;
  hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  hero.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) ir(k + (dx < 0 ? 1 : -1));
  }, { passive: true });
  new IntersectionObserver(([e]) => hero.classList.toggle('pl-hs-fuera', !e.isIntersecting)).observe(hero);
  const arrancar = () => setTimeout(() => { cargarFotos(); hero.classList.add('pl-hs-run'); }, 1200);
  if (document.readyState === 'complete') arrancar(); else addEventListener('load', arrancar);
  // Mapa decorativo de fondo: el iframe de Google solo se crea si el visitante ha aceptado las cookies
  const mapa = document.querySelector<HTMLElement>('.pl-map-bg');
  const conCookies = () => { try { return localStorage.getItem('mis-consent') === 'granted'; } catch { return false; } };
  const ponerMapa = () => {
    if (!mapa || mapa.firstChild || !conCookies()) return;
    const f = document.createElement('iframe');
    f.src = mapa.dataset.src!; f.title = mapa.dataset.title!; f.loading = 'lazy'; f.tabIndex = -1;
    f.referrerPolicy = 'no-referrer-when-downgrade';
    mapa.appendChild(f);
  };
  ponerMapa();
  document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-consent]')) setTimeout(ponerMapa, 50); });
  // content-visibility (rendimiento) se apaga antes de saltar a un ancla de la página (botones a #formulario, «Solicitar
  // valoración» de la cabecera a #info) o si se entra con #… en la dirección: así el navegador calcula la posición con las
  // alturas reales (con alturas provisionales el desplazamiento suave se pasaba de largo).
  const sinCV = () => document.documentElement.classList.add('pl-cv-off');
  document.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest('a[href^="#"]'); if (a && a.getAttribute('href')!.length > 1) sinCV(); }, true);
  if (location.hash.length > 1) { sinCV(); requestAnimationFrame(() => document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView()); }
  // «Por qué elegirnos»: punto activo
  document.querySelectorAll('.pl-why-list li').forEach((li) => li.addEventListener('mouseenter', () => {
    document.querySelectorAll('.pl-why-list li').forEach((x) => x.classList.toggle('on', x === li));
  }));
  // Equipo: lista ↔ foto
  const tb = [...document.querySelectorAll<HTMLButtonElement>('.pl-team-list button')];
  const tf = [...document.querySelectorAll<HTMLElement>('.pl-team-photo figure')];
  tb.forEach((b) => b.addEventListener('click', () => {
    tb.forEach((x) => x.classList.toggle('on', x === b));
    tf.forEach((f) => f.classList.toggle('on', f.dataset.i === b.dataset.i));
  }));
  // Opiniones: carrusel
  const ops = [...document.querySelectorAll('.pl-op')];
  const dots = [...document.querySelectorAll('.pl-dots button')];
  let o = 0;
  const show = (n: number) => { o = n; ops.forEach((x, i) => x.classList.toggle('on', i === n)); dots.forEach((x, i) => x.classList.toggle('on', i === n)); };
  dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
  setInterval(() => show((o + 1) % ops.length), 7000);
  // Vídeo: el póster y el vídeo (4 MB) solo se piden cuando la sección se acerca; se reproduce mientras está en pantalla
  const v = document.querySelector<HTMLVideoElement>('video[data-auto]');
  if (v) {
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { v.poster = v.dataset.poster!; v.src = v.dataset.src!; o.disconnect(); } }, { rootMargin: '600px 0px' }).observe(v);
    new IntersectionObserver(([e]) => { if (e.isIntersecting && v.src) v.play().catch(() => {}); else v.pause(); }, { threshold: .3 }).observe(v);
  }
  // Aparición suave (clases propias pl-rv/pl-in: .rv/.on son las de la animación del resto de la web)
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('pl-in'); io.unobserve(e.target); } }), { threshold: .12 });
  document.querySelectorAll('.pl-home > section:not(.pl-hero)').forEach((s) => { s.classList.add('pl-rv'); io.observe(s); });
</script>

<script>
  // Historias reales: filtros por cirugía, «Ver más» y diálogo con el embed de Instagram.
  // El iframe se crea SOLO al abrir el diálogo (nunca precargado) y se destruye al cerrarlo.
  // Consentimiento: se lee (solo lectura) la misma clave que escribe Consent.astro ('mis-consent').
  // TODO producción: si se sustituye el banner por una CMP externa, cambiar hayConsentimiento() para leer su estado.
  (() => {
    const sec = document.getElementById('historias');
    const grid = document.getElementById('plhgrid');
    if (!sec || !grid) return;
    const more = document.getElementById('plhmore')!;
    const moreBtn = document.getElementById('plhmorebtn')!;
    const empty = document.getElementById('plhempty')!;
    const dlg = document.getElementById('plhd') as HTMLDialogElement;
    const holder = document.getElementById('plhdf')!;
    const gate = document.getElementById('plhdg')!;
    const fil = [...sec.querySelectorAll<HTMLButtonElement>('.pl-hf')];
    const cards = [...grid.querySelectorAll<HTMLButtonElement>('.pl-hc')];
    const rm = matchMedia('(prefers-reduced-motion:reduce)').matches;
    let cur = 'todas', shown = 0, lastBtn: HTMLElement | null = null, current: HTMLElement | null = null;
    const cols = () => getComputedStyle(grid).gridTemplateColumns.split(' ').length;
    const pageSize = () => { const c = cols(); return c * Math.ceil(6 / c); }; // al menos 6 y filas completas
    const list = () => cards.filter((c) => (cur === 'todas' ? c.dataset.c !== 'obesidad' : c.dataset.c === cur));
    const label = (L: HTMLElement[]) => { moreBtn.textContent = sec.dataset.more + (L.length > shown ? ` (${L.length - shown})` : ''); };
    const render = (reset: boolean) => {
      const L = list();
      if (reset) shown = Math.min(pageSize(), L.length);
      cards.forEach((c) => { c.hidden = true; c.classList.remove('out'); });
      L.forEach((c, i) => { if (i < shown) { c.hidden = false; c.style.setProperty('--i', String(rm ? 0 : Math.min(i % pageSize(), 12))); } });
      empty.hidden = L.length > 0;
      more.hidden = shown >= L.length;
      label(L);
    };
    const setFilter = (f: string) => {
      if (f === cur) return;
      cur = f;
      fil.forEach((b) => { const on = b.dataset.f === f; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
      if (rm) { render(true); return; }
      cards.forEach((c) => { if (!c.hidden) c.classList.add('out'); });
      setTimeout(() => render(true), 190);
    };
    fil.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.f!)));
    moreBtn.addEventListener('click', () => {
      const prev = shown, L = list();
      shown = Math.min(shown + pageSize(), L.length);
      L.forEach((c, i) => { if (i < shown && c.hidden) { c.hidden = false; c.style.setProperty('--i', String(rm ? 0 : Math.min(i - prev, 12))); } });
      more.hidden = shown >= L.length;
      label(L);
    });
    let tmr: number;
    addEventListener('resize', () => { clearTimeout(tmr); tmr = window.setTimeout(() => render(true), 150); });

    const hayConsentimiento = () => { try { return localStorage.getItem('mis-consent') === 'granted'; } catch { return false; } };
    const insertarEmbed = () => {
      if (!current) return;
      const id = current.dataset.id!, n = current.dataset.n!;
      const f = document.createElement('iframe');
      f.src = `https://www.instagram.com/reel/${id}/embed/`;
      f.title = sec.dataset.vtitle!.replace('{n}', n);
      f.allow = 'autoplay; encrypted-media; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      holder.replaceChildren(f);
      gate.hidden = true;
    };
    const abrir = (btn: HTMLElement) => {
      lastBtn = current = btn;
      document.getElementById('plhdn')!.textContent = btn.dataset.n!;
      document.getElementById('plhdc')!.textContent = btn.dataset.l!;
      (document.getElementById('plhdl') as HTMLAnchorElement).href = `https://www.instagram.com/reel/${btn.dataset.id}/`;
      holder.replaceChildren();
      gate.hidden = true;
      dlg.showModal();
      if (hayConsentimiento()) insertarEmbed(); else gate.hidden = false;
    };
    cards.forEach((c) => c.addEventListener('click', () => abrir(c)));
    document.getElementById('plhdgb')!.addEventListener('click', insertarEmbed);
    document.getElementById('plhx')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => { holder.replaceChildren(); gate.hidden = true; current = null; lastBtn?.focus(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    render(true);
  })();
</script>
</body>
</html>
