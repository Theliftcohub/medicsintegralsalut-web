---
import menu from '../data/menu.json';
import site from '../data/site.json';
import Icon from './Icon.astro';
const { lang = 'es', alternates = {} } = Astro.props;
const items = (menu as any)[lang] ?? (menu as any).es;
const cta = (menu as any)[`cta_${lang}`] ?? (menu as any).cta_es;
const home = lang === 'es' ? '/' : `/${lang}/`;
const names: Record<string, string> = { es: 'Español', ca: 'Català', en: 'English', fr: 'Français', ru: 'Русский', uk: 'Українська' };
---
<header class="mp-header">
  <div class="mpost-wrap mp-header-inner">
    <a href={home} class="mp-logo"><img src={site.logo} alt={site.name} width="200" height="79" /></a>
    <input type="checkbox" id="mp-navt" class="mp-navt" aria-hidden="true" />
    <label for="mp-navt" class="mp-burger" aria-label="Menú"><span></span><span></span><span></span></label>
    <nav class="mp-nav" aria-label="Principal"><ul>
      {items.map((it: any) => (
        <li class:list={[it.children && 'has-sub']}>
          {it.children ? (
            <>
              <button type="button" class="mp-sub-btn" aria-haspopup="true">{it.text}</button>
              <div class="mp-mega"><div class="mpost-wrap mp-mega-grid">
                {it.children.map((g: any) => (
                  <div class="mp-mega-col"><a class="mp-mega-title" href={g.href}>{g.text}</a>
                    {g.children && <ul>{g.children.map((c: any) => <li><a href={c.href}>{c.text}</a>
                      {c.children && <ul>{c.children.map((d: any) => <li><a href={d.href}>{d.text}</a></li>)}</ul>}</li>)}</ul>}
                  </div>
                ))}
              </div></div>
            </>
          ) : <a href={it.href}>{it.text}</a>}
        </li>
      ))}
    </ul>
    {cta && <a class="mpost-btn b-primary mp-header-cta" href={cta.href}><Icon name="calendar" />{cta.text}</a>}
    {Object.keys(alternates).length > 1 && (
      <ul class="mp-langs">{Object.entries(alternates).map(([l, p]) => <li><a href={p as string} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{names[l] ?? l}</a></li>)}</ul>
    )}
    </nav>
  </div>
</header>
