---
import SeoHead from '../components/SeoHead.astro';
import Consent from '../components/Consent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VcHeader from '../components/vc/VcHeader.astro';
import VcFooter from '../components/vc/VcFooter.astro';
import site from '../data/site.json';
import '../styles/tokens.css';
import '../styles/base.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '../styles/mpost.css';
import '../styles/mp-extra.css';
import '@fontsource/raleway/200.css';
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '../styles/vc.css';
import '../styles/vc-extra.css';
import '../styles/mpost-posts.css';
import '../styles/vc-mpost.css';
const { seo, lang = 'es', alternates = {}, graph = [], breadcrumbs = [], theme = 'mpost' } = Astro.props;
const vc = theme === 'vc';
const entorno = import.meta.env.PUBLIC_ENTORNO ?? 'preview';
const crumbs = breadcrumbs.length > 1 ? [{
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.path, site.url).href })),
}] : [];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoHead seo={seo} lang={lang} alternates={alternates} graph={[...graph, ...crumbs]} />
  <Consent lang={lang} />
  {entorno !== 'preview' && site.gtm && (
    <script is:inline define:vars={{ id: site.gtm }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
    </script>
  )}
</head>
<body class:list={[vc && 'vc']}>
  {vc && <script is:inline>document.documentElement.classList.add('vc-js')</script>}
  {vc ? <VcHeader lang={lang} alternates={alternates} /> : <Header lang={lang} alternates={alternates} />}
  <main class:list={[!vc && 'mpost']}>
    {!vc && <Breadcrumbs items={breadcrumbs} />}
    {vc && breadcrumbs.length > 1 && <nav class="vc-crumbs" aria-label="Breadcrumb"><ol>{breadcrumbs.map((b: any, i: number) => <li>{i < breadcrumbs.length - 1 ? <a href={b.path}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>}
    <slot />
  </main>
  {vc ? <VcFooter lang={lang} /> : <Footer lang={lang} />}
</body>
</html>
