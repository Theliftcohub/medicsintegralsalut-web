---
import SeoHead from '../components/SeoHead.astro';
import ConsentMode from '../components/ConsentMode.astro';
import Consent from '../components/Consent.astro';
import VcHeader from '../components/vc/VcHeader.astro';
import VcFooter from '../components/vc/VcFooter.astro';
import site from '../data/site.json';
import '@fontsource/raleway/200.css';
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/500-italic.css';
// Orden de los estilos: variables -> comunes -> piel de los componentes .mpost -> maqueta «Versión C» y sus ajustes
import '../styles/tokens.css';
import '../styles/comun.css';
import '../styles/mpost.css';
import '../styles/vc.css';
import '../styles/vc-extra.css';
import '../styles/mpost-posts.css';
import '../styles/vc-mpost.css';
import '../styles/vc-prosa.css';
import '../styles/portada.css';
import '../styles/portada-extra.css';
import '../styles/fuentes.css';
import '../styles/portada-secciones.css';
// Toda la web usa el diseño «Versión C» (body.vc): cabecera, pie, migas y estilos.
const { seo, lang = 'es', alternates = {}, graph = [], breadcrumbs = [], precargar = [] } = Astro.props;
const entorno = import.meta.env.PUBLIC_ENTORNO ?? 'preview';
const crumbs = breadcrumbs.length > 1 ? [{
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.path, site.url).href })),
}] : [];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {precargar.map((f: string) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <SeoHead seo={seo} lang={lang} alternates={alternates} graph={[...graph, ...crumbs]} />
  <ConsentMode />
  {entorno !== 'preview' && site.gtm && (
    <script is:inline define:vars={{ id: site.gtm }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
    </script>
  )}
</head>
<body class="vc">
  <script is:inline>document.documentElement.classList.add('vc-js')</script>
  <VcHeader lang={lang} alternates={alternates} />
  <main>
    {breadcrumbs.length > 1 && <nav class="vc-crumbs" aria-label="Breadcrumb"><ol>{breadcrumbs.map((b: any, i: number) => <li>{i < breadcrumbs.length - 1 ? <a href={b.path}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>}
    <slot />
  </main>
  <VcFooter lang={lang} />
  <Consent lang={lang} />
</body>
</html>
