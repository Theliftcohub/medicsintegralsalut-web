---
const { title, text, image, imageAlt = '', cta, variant = 'simple', eyebrow } = Astro.props;
---
<section class={`b-hero b-hero--${variant}`}>
  <div class="wrap">
    <div class="b-hero__txt">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {text && <div class="b-hero__text" set:html={text} />}
      {cta && <a class="btn" href={cta.href}>{cta.text}</a>}
    </div>
    {image && <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />}
  </div>
</section>
