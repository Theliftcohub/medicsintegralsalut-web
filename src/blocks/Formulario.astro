---
// Envía a /form-handler.php (Plesk). En preview de Netlify se desactiva el envío.
import ui from '../i18n/ui.json';
const { name, fields = [], submit = 'Enviar', thanks, lang = 'es', tratamiento } = Astro.props;
const t = (ui as any)[lang] ?? ui.es;
const preview = (import.meta.env.PUBLIC_ENTORNO ?? 'preview') === 'preview';
---
<section class="b-form"><div class="wrap">
  {preview && <p class="aviso">{t.form_preview}</p>}
  <form action={preview ? '#' : '/form-handler.php'} method="post" data-form={name}>
    <input type="hidden" name="_form" value={name} />
    <input type="hidden" name="_lang" value={lang} />
    {tratamiento && <input type="hidden" name="tratamiento" value={tratamiento} />}
    {['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid','wbraid','gbraid','referrer'].map((k) => <input type="hidden" name={k} data-attr={k} />)}
    {thanks && <input type="hidden" name="_gracias" value={thanks} />}
    {fields.map((f: any) => (
      <label>{f.label}
        {f.type === 'textarea' ? <textarea name={f.name} required={f.required} placeholder={f.placeholder} />
         : f.type === 'checkbox' ? <input type="checkbox" name={f.name} required={f.required} />
         : <input type={f.type ?? 'text'} name={f.name} required={f.required} placeholder={f.placeholder} />}
      </label>
    ))}
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
    <button type="submit" class="btn" disabled={preview}>{submit}</button>
  </form>
</div></section>
<script is:inline>
  // Atribución para Kommo: guarda UTMs / click IDs de la primera página de la visita y los pasa al formulario.
  (function(){var K=['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid','wbraid','gbraid'];
  var q=new URLSearchParams(location.search),s={};try{s=JSON.parse(sessionStorage.getItem('mis-attr')||'{}')}catch(e){}
  if(K.some(function(k){return q.get(k)})){K.forEach(function(k){if(q.get(k))s[k]=q.get(k)});}
  if(!s.referrer&&document.referrer&&document.referrer.indexOf(location.host)<0)s.referrer=document.referrer;
  try{sessionStorage.setItem('mis-attr',JSON.stringify(s))}catch(e){}
  document.querySelectorAll('input[data-attr]').forEach(function(i){if(s[i.dataset.attr])i.value=s[i.dataset.attr]});})();
</script>
