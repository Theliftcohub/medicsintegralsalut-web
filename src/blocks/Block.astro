---
// ÚNICO punto donde se conectan tipos de bloque y componentes.
import VcHero from './vc/Hero.astro';
import VcEditorial from './vc/Editorial.astro';
import VcTrat from './vc/Trat.astro';
import VcUnidades from './vc/Unidades.astro';
import VcResenas from './vc/Resenas.astro';
import VcVideos from './vc/Videos.astro';
import VcVentajas from './vc/Ventajas.astro';
import VcEquipo from './vc/Equipo.astro';
import VcDistintivos from './vc/Distintivos.astro';
import VcContacto from './vc/Contacto.astro';
import VcCierre from './vc/Cierre.astro';
import VcMpost from './vc/Mpost.astro';
import VcProsa from './vc/Prosa.astro';
import VcTarjetas from './vc/Tarjetas.astro';
// portada «prototipo» (pt-*)
import PtHero from './portada/Hero.astro';
import PtClinica from './portada/Clinica.astro';
import PtTrat from './portada/Trat.astro';
import PtUnidades from './portada/Unidades.astro';
import PtTexto from './portada/Texto.astro';
import PtPasos from './portada/Pasos.astro';
import PtEquipo from './portada/Equipo.astro';
import PtDistintivos from './portada/Distintivos.astro';
import PtResenas from './portada/Resenas.astro';
import PtFaq from './portada/Faq.astro';
import PtContacto from './portada/Contacto.astro';
import PtCierre from './portada/Cierre.astro';
const { block, lang } = Astro.props;
const map: Record<string, any> = {
  'vc-hero': VcHero, 'vc-editorial': VcEditorial, 'vc-trat': VcTrat, 'vc-unidades': VcUnidades, 'vc-resenas': VcResenas, 'vc-videos': VcVideos, 'vc-ventajas': VcVentajas, 'vc-equipo': VcEquipo, 'vc-distintivos': VcDistintivos, 'vc-contacto': VcContacto, 'vc-cierre': VcCierre, 'vc-mpost': VcMpost, 'vc-prosa': VcProsa, 'vc-tarjetas': VcTarjetas,
  'pt-hero': PtHero, 'pt-clinica': PtClinica, 'pt-trat': PtTrat, 'pt-unidades': PtUnidades, 'pt-texto': PtTexto, 'pt-pasos': PtPasos, 'pt-equipo': PtEquipo, 'pt-distintivos': PtDistintivos, 'pt-resenas': PtResenas, 'pt-faq': PtFaq, 'pt-contacto': PtContacto, 'pt-cierre': PtCierre };
const C = map[block.type];
if (!C) throw new Error(`Bloque desconocido: ${block.type}`);
---
<C {...block} lang={lang} />
