---
// ÚNICO punto donde se conectan tipos de bloque y componentes.
import Hero from './Hero.astro';
import Texto from './Texto.astro';
import Tarjetas from './Tarjetas.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';
import Galeria from './Galeria.astro';
import Formulario from './Formulario.astro';
import MpHero from './mp/Hero.astro';
import MpSplit from './mp/Split.astro';
import MpCards from './mp/Cards.astro';
import MpUnits from './mp/Units.astro';
import MpVideos from './mp/Videos.astro';
import MpBenefits from './mp/Benefits.astro';
import MpTeam from './mp/Team.astro';
import MpContact from './mp/Contact.astro';
import MpReviews from './mp/Reviews.astro';
import MpNap from './mp/Nap.astro';
import VcHero from './vc/Hero.astro';
import VcEditorial from './vc/Editorial.astro';
import VcTrat from './vc/Trat.astro';
import VcUnidades from './vc/Unidades.astro';
import VcResenas from './vc/Resenas.astro';
import VcVideos from './vc/Videos.astro';
import VcVentajas from './vc/Ventajas.astro';
import VcEquipo from './vc/Equipo.astro';
import VcDistintivos from './vc/Distintivos.astro';
import VcContacto from './vc/Contacto.astro';
import VcCierre from './vc/Cierre.astro';
const { block, lang } = Astro.props;
const map: Record<string, any> = { hero: Hero, texto: Texto, tarjetas: Tarjetas, faq: Faq, cta: Cta, galeria: Galeria, formulario: Formulario,
  'mp-hero': MpHero, 'mp-split': MpSplit, 'mp-cards': MpCards, 'mp-units': MpUnits, 'mp-videos': MpVideos,
  'mp-benefits': MpBenefits, 'mp-team': MpTeam, 'mp-contact': MpContact, 'mp-reviews': MpReviews, 'mp-nap': MpNap,
  'vc-hero': VcHero, 'vc-editorial': VcEditorial, 'vc-trat': VcTrat, 'vc-unidades': VcUnidades, 'vc-resenas': VcResenas, 'vc-videos': VcVideos, 'vc-ventajas': VcVentajas, 'vc-equipo': VcEquipo, 'vc-distintivos': VcDistintivos, 'vc-contacto': VcContacto, 'vc-cierre': VcCierre };
const C = map[block.type];
if (!C) throw new Error(`Bloque desconocido: ${block.type}`);
---
<C {...block} lang={lang} />
