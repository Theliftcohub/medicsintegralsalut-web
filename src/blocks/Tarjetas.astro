---
const { title, columns = 3, items = [] } = Astro.props;
---
<section class="b-tarjetas"><div class="wrap">
  {title && <h2 set:html={title} />}
  <ul class="grid" style={`--cols:${columns}`}>
    {items.map((i: any) => <li class="card">
      {i.image && <img src={i.image} alt={i.imageAlt ?? ''} loading="lazy" />}
      <h3>{i.href ? <a href={i.href} set:html={i.title} /> : <span set:html={i.title} />}</h3>
      {i.text && <div set:html={i.text} />}
    </li>)}
  </ul>
</div></section>
