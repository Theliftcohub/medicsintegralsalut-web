---
// Cabecera de página interior con el estilo de la portada: texto a la izquierda y foto en arco con una cita.
import { ext } from '../../lib/vc';
const { kicker, headingTag = 'h1', heading, text, ctas = [], image, quote } = Astro.props;
const H = headingTag;
---
<section class="pt-pagehero">
  <div class="pt-wrap pt-pagehero-g">
    <div>
      {kicker && <div class="pt-eyebrow rv">{kicker}</div>}
      <H class="rv d1">{heading}</H>
      {text && <p class="pt-pagehero-sub rv d2" set:html={text} />}
      <div class="pt-pagehero-cta rv d3">
        {ctas.map((c: any) => <a class:list={['pt-btn', c.style === 'wa' && 'pt-linea']} href={c.href} {...ext(c.href)}>{c.text}</a>)}
      </div>
    </div>
    <div class="pt-pf rv d2">
      <div class="pt-pf-fondo"></div>
      <div class="pt-pf-marco"><img src={image.src} alt={image.alt} width={image.w} height={image.h} fetchpriority="high" decoding="async" /></div>
      {quote && <blockquote class="pt-pf-cita"><p set:html={quote.html} /><cite>{quote.author}</cite></blockquote>}
    </div>
  </div>
</section>
