---
// Unidades (portada, rediseño 06/10/2026 v2): un bloque con pestañas. A la izquierda las unidades; a la derecha, los
// tratamientos de la elegida. Las demás pestañas solo se ocultan (hidden): todos los enlaces siguen en el HTML.
// Mismos títulos, textos y enlaces que antes. Teclado: flechas arriba/abajo (izquierda/derecha en móvil), Inicio y Fin.
const { id, kicker, heading, headingTag = 'h2', text = [], unidades = [], cta, label } = Astro.props;
const H = headingTag;
---
<section id={id} class="pu">
  <div class="pt-wrap">
    {(heading || cta) && <div class="pu-cab">
      <div>
        {kicker && <div class="ps-k rv">{kicker}</div>}
        {heading && <H class="rv d1">{heading}</H>}
        {text.map((p: string) => <p class="pu-intro rv d2" set:html={p} />)}
      </div>
      {cta && <a class="ps-btn rv d2" href={cta.href}>{cta.text}</a>}
    </div>}
    <div class="pu-box rv">
      <div class="pu-nav" role="tablist" aria-label={heading || label} aria-orientation="vertical">
        {unidades.map((u: any, i: number) => (
          <button type="button" class="pu-tab" role="tab" id={`pu-t${i}`} aria-controls={`pu-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span>{u.title}</span><small aria-hidden="true">{u.links.length}</small>
          </button>
        ))}
      </div>
      <div class="pu-paneles">
        {unidades.map((u: any, i: number) => (
          <div class="pu-panel" role="tabpanel" id={`pu-p${i}`} aria-labelledby={`pu-t${i}`} hidden={i !== 0}>
            <h3>{u.href ? <a href={u.href}>{u.title}</a> : u.title}</h3>
            <ul>{u.links.map((l: any) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('.pu-box').forEach(function(box){var ts=[].slice.call(box.querySelectorAll('.pu-tab')),ps=box.querySelectorAll('.pu-panel');
      function ir(n,foco){ts.forEach(function(t,k){var on=k===n;t.setAttribute('aria-selected',on?'true':'false');t.tabIndex=on?0:-1;ps[k].hidden=!on;});if(foco)ts[n].focus();}
      ts.forEach(function(t,k){t.addEventListener('click',function(){ir(k);});
        t.addEventListener('keydown',function(e){var n={ArrowDown:k+1,ArrowRight:k+1,ArrowUp:k-1,ArrowLeft:k-1,Home:0,End:ts.length-1}[e.key];
          if(n===undefined)return;e.preventDefault();ir((n+ts.length)%ts.length,true);});});});
  </script>
</section>
