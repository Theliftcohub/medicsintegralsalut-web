---
// Unidades (portada, rediseño 06/10/2026): índice de especialidades en filas (número, unidad y sus tratamientos como
// etiquetas), con filtro por zona. Los filtros solo ocultan (hidden): todos los enlaces siguen en el HTML. Mismos textos
// y enlaces que antes (la flecha de cada unidad es CSS, no forma parte del texto del enlace).
const { id, kicker, heading, text = [], filtros, unidades = [], cta } = Astro.props;
const zonas = ['todas', 'facial', 'corporal', 'mamas', 'masculina', 'obesidad', 'cosmetica'];
---
<section id={id} class="pu">
  <div class="pt-wrap">
    <div class="pu-cab">
      <div>
        {kicker && <div class="ps-k rv">{kicker}</div>}
        <h2 class="rv d1">{heading}</h2>
        {text.map((p: string) => <p class="pu-intro rv d2" set:html={p} />)}
      </div>
      <div class="pu-chips rv d2" role="tablist" aria-label={filtros.label}>
        {zonas.map((z, i) => <button type="button" class="pu-chip" role="tab" data-f={z} aria-selected={i === 0 ? 'true' : 'false'}>{filtros[z]}</button>)}
      </div>
    </div>
    <ol class="pu-lista rv">
      {unidades.map((u: any) => (
        <li class="pu-fila" data-c={u.c}>
          <h3>{u.href ? <a href={u.href}>{u.title}</a> : u.title}</h3>
          <ul>{u.links.map((l: any) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
        </li>
      ))}
    </ol>
    {cta && <p class="pu-cta"><a class="ps-btn" href={cta.href}>{cta.text}</a></p>}
  </div>
  <script is:inline>
    document.querySelectorAll('.pu-chips').forEach(function(ch){var bs=ch.querySelectorAll('.pu-chip'),us=ch.closest('.pu').querySelectorAll('.pu-fila');
      bs.forEach(function(b){b.addEventListener('click',function(){bs.forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false')});
        var f=b.dataset.f;us.forEach(function(u){u.hidden=!(f==='todas'||u.dataset.c===f)});});});});
  </script>
</section>
