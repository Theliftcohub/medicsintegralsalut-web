---
// Hero de la portada: foto real de la clínica a sangre, título con la parte destacada en cursiva (<em>), dos botones y
// la nota de Google (site.json -> rating). Diseño del pantallazo de dirección (05/10/2026).
import { fill, ratingText, ext } from '../../lib/vc';
const { eyebrow, titleHtml, sub, ctas = [], reviews, badge, image, lang = 'es' } = Astro.props;
const wa = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/></svg>';
---
<section class="pt-hero">
  <img class="pt-hero-img" src={image.src} alt={image.alt} width={image.w} height={image.h} fetchpriority="high" decoding="async" />
  <div class="pt-wrap pt-hero-in">
    <p class="pt-hero-eyebrow">{fill(eyebrow, lang)}</p>
    <h2 class="pt-hero-t" set:html={titleHtml} />
    <p class="pt-hero-sub">{sub}</p>
    <div class="pt-hero-cta">
      {ctas.map((c: any) => <a class:list={['pt-btn', c.style === 'wa' && 'pt-btn-wa']} href={c.href} {...ext(c.href)}>{c.style === 'wa' && <Fragment set:html={wa} />}{c.text}</a>)}
    </div>
    <p class="pt-hero-trust">
      <span class="pt-estrellas" aria-hidden="true">★★★★★</span><b>{ratingText(lang)}</b><span>· {fill(reviews, lang)}</span>
      <i aria-hidden="true"></i><span>{badge}</span>
    </p>
  </div>
</section>
