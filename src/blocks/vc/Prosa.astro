---
// Contenido literal del WordPress reducido a HTML semántico (filas de WPBakery, fichas, legales) con la tipografía «Versión C».
// Una fila = una sección; sus columnas se reparten en rejilla. Los formularios CF7 pasan a formulario propio (→ Kommo).
import NativeForm from '../../components/NativeForm.astro';
import ui from '../../i18n/ui.json';
const { cols = [], bg, id, stack = false, lang = 'es' } = Astro.props;
const n = stack ? 1 : Math.min(cols.length, 4);
const t = (ui as any)[lang] ?? ui.es;
const fill = (h: string) => h.replaceAll('{{map_load}}', t.map_load);
---
<section id={id} class:list={['vc-prosa', bg]}>
  <div class:list={['wrap', n > 1 && `vc-cols vc-cols-${n}`, stack && 'vc-stack']}>
    {cols.map((c: any) => c.form
      ? <div class="vc-col vc-formbox vc-formbox--solo" id="form"><NativeForm form={c.form} lang={lang} cls="vc-form" btnClass="btn" btnSpan /></div>
      : <div class="vc-col vc-texto-rico" set:html={fill(c.html)} />)}
  </div>
</section>
