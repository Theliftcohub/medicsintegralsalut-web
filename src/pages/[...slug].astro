---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Block from '../blocks/Block.astro';
import ui from '../i18n/ui.json';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = await getCollection('posts');
  // Mapa de traducciones: i18nGroup -> { lang: path }
  const groups: Record<string, Record<string, string>> = {};
  for (const e of [...pages, ...posts]) if (e.data.i18nGroup) (groups[e.data.i18nGroup] ??= {})[e.data.lang] = e.data.path;
  const toSlug = (p: string) => (p === '/' ? undefined : p.replace(/^\/|\/$/g, ''));
  return [
    ...pages.map((e) => ({ params: { slug: toSlug(e.data.path) }, props: { kind: 'page', entry: e, alternates: e.data.i18nGroup ? groups[e.data.i18nGroup] : {} } })),
    ...posts.map((e) => ({ params: { slug: toSlug(e.data.path) }, props: { kind: 'post', entry: e, alternates: e.data.i18nGroup ? groups[e.data.i18nGroup] : {} } })),
  ];
}
const { kind, entry, alternates } = Astro.props as any;
const d = entry.data;
const t = (ui as any)[d.lang] ?? ui.es;
const fmt = (x: Date) => x.toLocaleDateString(d.lang, { day: 'numeric', month: 'long', year: 'numeric' });
let Content: any = null;
let graph: any[] = [];
if (kind === 'post') {
  ({ Content } = await render(entry));
  graph = [{
    '@type': 'BlogPosting', headline: d.title, datePublished: d.date.toISOString(), dateModified: (d.modified ?? d.date).toISOString(),
    author: { '@type': 'Person', name: d.author, ...(d.authorUrl ? { url: new URL(d.authorUrl, Astro.site).href } : {}) },
    ...(d.image ? { image: new URL(d.image, Astro.site).href } : {}), inLanguage: d.lang,
    mainEntityOfPage: new URL(d.path, Astro.site).href, publisher: { '@id': `${Astro.site?.origin}/#org` },
  }];
} else {
  graph = d.schema.map((s: any) => ({ '@type': s.type, ...s, type: undefined }));
}
const seo = kind === 'post' ? { title: d.seoTitle ?? d.title, description: d.description, canonical: d.canonical, robots: d.robots, ogImage: d.image } : d.seo;
---
<Base seo={seo} lang={d.lang} alternates={alternates} graph={graph} breadcrumbs={d.breadcrumbs ?? []} theme={kind === 'page' ? d.theme : 'vc'}>
  {kind === 'page' && d.blocks.map((b: any) => <Block block={b} lang={d.lang} />)}
  {kind === 'post' && (
    <>
    <section class="vc-prosa vc-post-head"><div class="wrap">
      <header class="vc-texto-rico vc-post">
        {d.category && <div class="kicker">{d.category}</div>}
        <h1>{d.h1 ?? d.title}</h1>
        <p class="vc-post-meta">{t.published} <time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time>
          {d.modified && d.modified.getTime() !== d.date.getTime() && <> · {t.updated} <time datetime={d.modified.toISOString().slice(0, 10)}>{fmt(d.modified)}</time></>}
          · {t.by} {d.authorUrl ? <a href={d.authorUrl} rel="author">{d.author}</a> : d.author}</p>
        {d.image && !d.mpost && <img class="vc-post-img" src={d.image} alt={d.imageAlt} />}
      </header>
    </div></section>
    {d.mpost ? <div class="vc-post-mpost"><Content /></div> : (
      <section class="vc-prosa vc-post-body"><div class="wrap"><article class="vc-texto-rico vc-post"><Content /></article></div></section>
    )}
    </>
  )}
</Base>
