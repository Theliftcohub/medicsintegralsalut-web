---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Block from '../blocks/Block.astro';
import PropuestaHome from '../components/propuesta/PropuestaHome.astro';
import sharp from 'sharp';
// Raleway (texto y titulares de las páginas «Versión C»: tratamientos, entradas, legales): se precargan los dos grosores
// que se ven al cargar, para que el texto no cambie de tamaño al llegar la fuente (CLS en móvil).
import raleway300 from '@fontsource/raleway/files/raleway-latin-300-normal.woff2?url';
import raleway200 from '@fontsource/raleway/files/raleway-latin-200-normal.woff2?url';
import ui from '../i18n/ui.json';
import { prepararBloques } from '../lib/paginas';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = await getCollection('posts');
  // Mapa de traducciones: i18nGroup -> { lang: path }. Solo entran versiones canónicas e indexables (Google descarta
  // un hreflang que apunta a una página noindex o con canonical a otra); esas páginas no publican hreflang.
  const canonica = (e: any) => {
    const can = e.data.seo?.canonical ?? e.data.canonical;
    const rob = e.data.seo?.robots ?? e.data.robots ?? '';
    return !rob.includes('noindex') && (!can || decodeURI(new URL(can).pathname) === e.data.path);
  };
  const groups: Record<string, Record<string, string>> = {};
  for (const e of [...pages, ...posts]) if (e.data.i18nGroup && canonica(e)) (groups[e.data.i18nGroup] ??= {})[e.data.lang] = e.data.path;
  const alt = (e: any) => (e.data.i18nGroup && canonica(e) ? groups[e.data.i18nGroup] : {});
  const toSlug = (p: string) => (p === '/' ? undefined : p.replace(/^\/|\/$/g, ''));
  return [
    ...pages.map((e) => ({ params: { slug: toSlug(e.data.path) }, props: { kind: 'page', entry: e, alternates: alt(e) } })),
    ...posts.map((e) => ({ params: { slug: toSlug(e.data.path) }, props: { kind: 'post', entry: e, alternates: alt(e) } })),
  ];
}
const { kind, entry, alternates } = Astro.props as any;
const d = entry.data;
const t = (ui as any)[d.lang] ?? ui.es;
const fmt = (x: Date) => x.toLocaleDateString(d.lang, { day: 'numeric', month: 'long', year: 'numeric' });
let Content: any = null;
let graph: any[] = [];
if (kind === 'post') {
  ({ Content } = await render(entry));
  graph = [{
    '@type': 'BlogPosting', headline: d.title, datePublished: d.date.toISOString(), dateModified: (d.modified ?? d.date).toISOString(),
    author: { '@type': 'Person', name: d.author, ...(d.authorUrl ? { url: new URL(d.authorUrl, Astro.site).href } : {}) },
    ...(d.image ? { image: new URL(d.image, Astro.site).href } : {}), inLanguage: d.lang,
    mainEntityOfPage: new URL(d.path, Astro.site).href, publisher: { '@id': `${Astro.site?.origin}/#org` },
  }, ...d.schema.map((s: any) => ({ '@type': s.type, ...s, type: undefined }))];
} else {
  graph = d.schema.map((s: any) => ({ '@type': s.type, ...s, type: undefined }));
}
// Portada (6 idiomas): diseño estilo /clinica/ (PropuestaHome). El SEO (title, description, canonical, hreflang, JSON-LD)
// sigue saliendo de home.json, igual que antes.
const esPortada = kind === 'page' && d.i18nGroup === 'home';
const conRaleway = !esPortada && !(kind === 'page' && d.theme === 'portada');
// foto principal de las entradas con su ancho y alto reales (sin ellos la página salta al cargarla: CLS)
let fotoPost: { w?: number; h?: number } = {};
if (kind === 'post' && d.image?.startsWith('/')) {
  try { const m = await sharp('public' + decodeURI(d.image)).metadata(); fotoPost = { w: m.width, h: m.height }; } catch { /* sin copia local */ }
}
const blocks = kind === 'page' ? prepararBloques(d.blocks, d.title) : [];
const seo = kind === 'post' ? { title: d.seoTitle ?? d.title, description: d.description, canonical: d.canonical, robots: d.robots, ogImage: d.image } : d.seo;
---
<Base seo={seo} lang={d.lang} alternates={alternates} graph={graph} breadcrumbs={d.breadcrumbs ?? []}
  precargar={esPortada ? (['ru', 'uk'].includes(d.lang) ? [] : ['/fonts/figtree-latin.woff2'])
    : kind === 'page' && d.theme === 'portada' ? (['ru', 'uk'].includes(d.lang) ? [] : ['/fonts/bricolage-800-latin.woff2', '/fonts/figtree-latin.woff2'])
    : conRaleway ? [raleway300, raleway200] : []}>
  {esPortada
    ? <PropuestaHome lang={d.lang} />
    : kind === 'page' && d.theme === 'portada'
    ? <div class:list={['pt', 'pt-n']}>{blocks.map((b: any) => <Block block={b} lang={d.lang} />)}</div>
    : blocks.map((b: any) => <Block block={b} lang={d.lang} />)}
  {kind === 'post' && (
    <>
    <section class="vc-prosa vc-post-head"><div class="wrap">
      <header class="vc-texto-rico vc-post">
        {d.category && <div class="kicker">{d.category}</div>}
        <h1>{d.h1 ?? d.title}</h1>
        <p class="vc-post-meta">{t.published} <time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time>
          {d.modified && d.modified.getTime() !== d.date.getTime() && <> · {t.updated} <time datetime={d.modified.toISOString().slice(0, 10)}>{fmt(d.modified)}</time></>}
          · {t.by} {d.authorUrl ? <a href={d.authorUrl} rel="author">{d.author}</a> : d.author}</p>
        {d.image && <img class="vc-post-img" src={d.image} alt={d.imageAlt} width={fotoPost.w} height={fotoPost.h} fetchpriority="high" decoding="async" />}
      </header>
    </div></section>
    {d.mpost ? (
      <section class="vc-prosa vc-post-body"><div class="wrap"><article class="vc-post vc-post-mpost"><Content /></article></div>
      <script is:inline>document.querySelectorAll('.vc-post-mpost .mpp-filters').forEach(function(f){var bs=f.querySelectorAll('button'),root=f.parentNode;bs.forEach(function(b){b.addEventListener('click',function(){bs.forEach(function(x){x.classList.remove('is-active')});b.classList.add('is-active');var v=b.getAttribute('data-f');root.querySelectorAll('.mpp-grid .card').forEach(function(c){c.style.display=(v==='all'||c.getAttribute('data-cat')===v)?'':'none'})})})});</script></section>
    ) : (
      <section class="vc-prosa vc-post-body"><div class="wrap"><article class="vc-texto-rico vc-post"><Content /></article></div></section>
    )}
    </>
  )}
</Base>
